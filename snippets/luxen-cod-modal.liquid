<style>
#luxen-cod-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 999999;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
#luxen-cod-modal-overlay.is-active {
  display: flex !important;
}
.cod-modal-content {
  background: #fff; width: 100%; max-width: 500px; margin: auto;
  border-radius: 12px; position: relative;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  max-height: 90vh;
  overflow-y: auto;
}
.cod-modal-header {
  background: #f8f8f8; padding: 15px 20px; border-radius: 12px 12px 0 0;
  display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid #eaeaea;
}
.cod-modal-header h2 { margin: 0; font-size: 1.15rem; font-weight: 900; color: #111; letter-spacing: 0.5px; }
.cod-modal-close { font-size: 1.5rem; cursor: pointer; color: #444; line-height: 1; font-weight: bold; }

.cod-modal-body { padding: 20px; }
.cod-offer-card {
  display: flex; align-items: center; border: 2px solid #EAEAEA;
  border-radius: 8px; padding: 12px; margin-bottom: 12px;
  cursor: pointer; position: relative; transition: all 0.2s;
  background: #FFF;
}
.cod-offer-card.active { border-color: #FF6B00; background: #FFF8F3; }
.cod-offer-card input { accent-color: #FF6B00; width: 20px; height: 20px; margin-right: 12px; cursor: pointer; }
.cod-offer-details { flex: 1; }
.cod-offer-title { font-weight: 800; font-size: 0.95rem; color: #111; display:flex; align-items:center; }
.cod-offer-price { font-weight: 800; color: #FF6B00; font-size: 1.05rem; margin-top: 3px; }
.cod-offer-badge {
  position: absolute; top: -10px; right: 10px; background: #E11D48;
  color: #FFF; font-size: 0.75rem; font-weight: 800; padding: 3px 8px;
  border-radius: 12px; text-transform: uppercase;
}
.cod-free-shipping { font-size: 0.7rem; color: #16A34A; font-weight: 800; margin-left: 6px; background:#DCFCE7; padding: 2px 6px; border-radius:4px; }

.cod-breakdown {
  background: #F9F9F9; padding: 12px; border-radius: 8px;
  margin-bottom: 20px; font-size: 0.95rem; border: 1px dashed #CCC;
}
.cod-breakdown-row { display: flex; justify-content: space-between; margin-bottom: 6px; color: #555; }
.cod-breakdown-row.total { font-weight: 900; font-size: 1.2rem; color: #111; border-top: 1px solid #DDD; padding-top: 8px; margin-bottom: 0; }

.cod-form-title { font-size: 1.05rem; font-weight: 800; margin-bottom: 15px; text-align: center; color: #111; }
.cod-field { margin-bottom: 12px; }
.cod-field input, .cod-field select {
  width: 100%; padding: 12px; border: 1px solid #ddd;
  border-radius: 6px; font-size: 0.95rem; background: #fff;
  font-family: inherit; color: #333;
}
.cod-field input:focus, .cod-field select:focus { border-color: #FF6B00; outline: none; }
.cod-row { display: flex; gap: 10px; }
.cod-row .cod-field { flex: 1; }

.cod-submit-btn {
  width: 100%; background: #FF6B00; color: #fff;
  border: none; border-radius: 8px; padding: 16px;
  font-size: 1.05rem; font-weight: 900; cursor: pointer;
  margin-top: 5px; text-transform: uppercase; box-shadow: 0 4px 12px rgba(255,107,0,0.3);
  transition: background 0.3s;
}
.cod-submit-btn:hover { background: #E65D00; }
.cod-guarantee { text-align: center; font-size: 0.85rem; font-weight: 800; color: #16A34A; margin-top: 15px; display: flex; align-items:center; justify-content:center; gap:5px;}
</style>

<!-- Modal -->
<div id="luxen-cod-modal-overlay">
  <div class="cod-modal-content" id="cod-modal-content">
    <div class="cod-modal-header">
      <h2>PAGO CONTRA ENTREGA</h2>
      <div class="cod-modal-close" id="close-cod-modal">&times;</div>
    </div>
    
    <div class="cod-modal-body">
      <!-- Ofertas / Combos -->
      <div id="cod-offers-container">
        <label class="cod-offer-card active" data-qty="1" data-price="{{ product.price | money }}" data-raw-price="{{ product.price }}">
          <input type="radio" name="cod-combo" value="1" checked>
          <div class="cod-offer-details">
            <div class="cod-offer-title">1 UNIDAD <span class="cod-free-shipping">ENVÍO GRATIS ✓</span></div>
            <div class="cod-offer-price">{{ product.price | money }}</div>
          </div>
        </label>
        
        <label class="cod-offer-card" data-qty="2" data-price="{{ product.price | times: 1.8 | money }}" data-raw-price="{{ product.price | times: 1.8 }}">
          <span class="cod-offer-badge">AHORRA </span>
          <input type="radio" name="cod-combo" value="2">
          <div class="cod-offer-details">
            <div class="cod-offer-title">2 UNIDADES + OFERTA</div>
            <div class="cod-offer-price">{{ product.price | times: 1.8 | money }}</div>
          </div>
        </label>
        
        <label class="cod-offer-card" data-qty="3" data-price="{{ product.price | times: 2.5 | money }}" data-raw-price="{{ product.price | times: 2.5 }}">
          <span class="cod-offer-badge">AHORRA </span>
          <input type="radio" name="cod-combo" value="3">
          <div class="cod-offer-details">
            <div class="cod-offer-title">3 UNIDADES + OFERTA MÁXIMA</div>
            <div class="cod-offer-price">{{ product.price | times: 2.5 | money }}</div>
          </div>
        </label>
      </div>

      <!-- Breakdown Numérico -->
      <div class="cod-breakdown">
        <div class="cod-breakdown-row">
          <span>Subtotal</span>
          <span id="cod-subtotal">{{ product.price | money }}</span>
        </div>
        <div class="cod-breakdown-row">
          <span>Envío</span>
          <span style="color:#16A34A; font-weight:700;">Gratis</span>
        </div>
        <div class="cod-breakdown-row total">
          <span>Total a Pagar</span>
          <span id="cod-total">{{ product.price | money }}</span>
        </div>
      </div>

      <!-- Formulario de Envío -->
      <div class="cod-form-title">Ingrese su dirección de envío</div>
      <div class="cod-row">
        <div class="cod-field"><input type="text" id="cod-fname" placeholder="Nombre" required></div>
        <div class="cod-field"><input type="text" id="cod-lname" placeholder="Apellido" required></div>
      </div>
      <div class="cod-field">
        <input type="tel" id="cod-cel" placeholder="Celular / WhatsApp (Ej: 0991234567)" required>
      </div>
      <div class="cod-field">
        <select id="cod-prov" required>
          <option value="" disabled selected>Provincia...</option>
          <option value="Guayas">Guayas</option>
          <option value="Pichincha">Pichincha</option>
          <option value="Azuay">Azuay</option>
          <option value="Manabí">Manabí</option>
          <option value="El Oro">El Oro</option>
          <option value="Los Ríos">Los Ríos</option>
          <option value="Otra">Otra</option>
        </select>
      </div>
      <div class="cod-field">
        <input type="text" id="cod-dir" placeholder="Dirección Exacta (Calle, Nro casa)" required>
      </div>
      <div class="cod-field">
        <input type="text" id="cod-ref" placeholder="Referencias adicionales (Opcional)">
      </div>

      <button type="button" class="cod-submit-btn" id="cod-submit-btn">
        ✔ COMPLETA TU COMPRA - {{ product.price | money }} | Paga al recibir
      </button>

      <div class="cod-guarantee">
        🛡️ 100% GARANTÍA EN NUESTROS PRODUCTOS
      </div>
    </div>
  </div>
</div>

<script>
// Exponer globalmente la funcion
window.abrirLuxenModal = function(e) {
  if (e) e.preventDefault();
  const modal = document.getElementById('luxen-cod-modal-overlay');
  if (modal) {
    modal.style.setProperty('display', 'flex', 'important');
    document.body.style.overflow = 'hidden';
  } else {
    console.error("Error: #luxen-cod-modal-overlay no se encuentra en el DOM.");
  }
};

window.cerrarLuxenModal = function(e) {
  if (e) e.preventDefault();
  const modal = document.getElementById('luxen-cod-modal-overlay');
  if (modal) {
    modal.style.setProperty('display', 'none', 'important');
    document.body.style.overflow = '';
  }
};

// Event Delegation global
document.addEventListener('click', function(e) {
  const target = e.target.closest('#trigger-cod-modal, .btn-cod-trigger');
  if (target) {
    window.abrirLuxenModal(e);
  }
});

document.addEventListener('DOMContentLoaded', () => {
  const codModal = document.getElementById('luxen-cod-modal-overlay');
  const closeBtn = document.getElementById('close-cod-modal');
  
  if (codModal) {
    // Cerrar modal - botón X
    if(closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        window.cerrarLuxenModal(e);
      });
    }

    // Cerrar modal - clic fuera
    codModal.addEventListener('click', (e) => {
      if(e.target === codModal) {
        window.cerrarLuxenModal(e);
      }
    });

    // Cerrar modal - tecla ESC
    document.addEventListener('keydown', (e) => {
      if(e.key === 'Escape') {
        window.cerrarLuxenModal(e);
      }
    });
  }

  // Lógica de ofertas y actualización de totales
  const offerCards = document.querySelectorAll('.cod-offer-card');
  let currentQty = 1;
  let currentTotalStr = '{{ product.price | money }}';

  offerCards.forEach(card => {
    card.addEventListener('click', (e) => {
      offerCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      
      const radio = card.querySelector('input[type="radio"]');
      if(radio) radio.checked = true;

      currentQty = card.getAttribute('data-qty');
      currentTotalStr = card.getAttribute('data-price');
      
      document.getElementById('cod-subtotal').innerText = currentTotalStr;
      document.getElementById('cod-total').innerText = currentTotalStr;
      document.getElementById('cod-submit-btn').innerText = '✔ COMPLETA TU COMPRA - ' + currentTotalStr + ' | Paga al recibir';
    });
  });

  // Envío del pedido a WhatsApp
  const submitBtn = document.getElementById('cod-submit-btn');
  if(submitBtn) {
    submitBtn.addEventListener('click', () => {
      const fname = document.getElementById('cod-fname').value.trim();
      const lname = document.getElementById('cod-lname').value.trim();
      const cel = document.getElementById('cod-cel').value.trim();
      const prov = document.getElementById('cod-prov').value;
      const dir = document.getElementById('cod-dir').value.trim();
      const ref = document.getElementById('cod-ref').value.trim();
      
      if(!fname || !lname || !cel || !prov || !dir) {
        alert("Por favor completa todos los campos requeridos para coordinar tu envío.");
        return;
      }
      
      const productTitle = "{{ product.title | escape }}";
      
      let msg = "Hola LUXEN, he completado mi formulario de Contra Entrega:\n\n";
      msg += "🛍️ *Producto:* " + productTitle + "\n";
      msg += "📦 *Cantidad:* " + currentQty + " Unidad(es)\n";
      msg += "💵 *Total a pagar:* " + currentTotalStr + " (Envío Gratis)\n\n";
      msg += "👤 *Cliente:* " + fname + " " + lname + "\n";
      msg += "📱 *Celular:* " + cel + "\n";
      msg += "📍 *Provincia:* " + prov + "\n";
      msg += "🏠 *Dirección:* " + dir + "\n";
      if(ref) msg += "📝 *Ref:* " + ref + "\n";
      msg += "\n✅ ¡Por favor confirmen mi despacho!";
      
      window.location.href = "https://wa.me/593969280600?text=" + encodeURIComponent(msg);
    });
  }
});
</script>