<style>
  .product-form__submit, .shopify-payment-button { display: none !important; }
  .product-form__error-message-wrapper, .form__message--error { display: none !important; }
  .luxen-cod-form-container {
    background: #FAFAFA;
    border: 2px dashed #C5A059;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 25px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
  }
  .luxen-cod-header {
    text-align: center;
    font-size: 1.1rem;
    font-weight: 800;
    color: #111;
    margin-bottom: 15px;
    text-transform: uppercase;
  }
  .luxen-cod-field {
    margin-bottom: 12px;
  }
  .luxen-cod-field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 5px;
    color: #333;
  }
  .luxen-cod-field input, .luxen-cod-field select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.3s;
  }
  .luxen-cod-field input:focus, .luxen-cod-field select:focus {
    outline: none;
    border-color: #C5A059;
  }
  .luxen-cod-row {
    display: flex;
    gap: 10px;
  }
  .luxen-cod-row .luxen-cod-field {
    flex: 1;
  }
  .luxen-cod-offers {
    margin: 15px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .luxen-cod-offer-card {
    display: flex;
    align-items: center;
    border: 2px solid #EEE;
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    background: #FFF;
    transition: all 0.2s;
    position: relative;
  }
  .luxen-cod-offer-card.active {
    border-color: #FF6B00;
    background: #FFF8F3;
  }
  .luxen-cod-offer-card input {
    margin-right: 12px;
    accent-color: #FF6B00;
    width: 18px;
    height: 18px;
  }
  .luxen-cod-offer-details {
    flex: 1;
  }
  .luxen-cod-offer-title {
    font-weight: 800;
    font-size: 0.95rem;
    color: #111;
  }
  .luxen-cod-offer-price {
    font-weight: 800;
    color: #FF6B00;
    font-size: 1.1rem;
  }
  .luxen-cod-badge {
    position: absolute;
    top: -10px;
    right: 10px;
    background: #FF6B00;
    color: #FFF;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 12px;
    text-transform: uppercase;
  }
  .luxen-cod-btn-submit {
    width: 100%;
    background: linear-gradient(135deg, #FF8C00, #FF6B00);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 16px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 4px 15px rgba(255,107,0,0.3);
    animation: codPulse 2s infinite;
    transition: transform 0.2s;
    margin-top: 10px;
  }
  .luxen-cod-btn-submit:active {
    transform: scale(0.98);
  }
  .luxen-cod-btn-title {
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .luxen-cod-btn-sub {
    font-size: 0.9rem;
    font-weight: 500;
    margin-top: 4px;
    opacity: 0.9;
  }
  .luxen-cod-trust {
    text-align: center;
    font-size: 0.85rem;
    color: #555;
    margin-top: 12px;
    font-weight: 600;
  }
  @keyframes codPulse {
    0% { box-shadow: 0 0 0 0 rgba(255,107,0,0.5); }
    70% { box-shadow: 0 0 0 10px rgba(255,107,0,0); }
    100% { box-shadow: 0 0 0 0 rgba(255,107,0,0); }
  }
</style>

<div class="luxen-cod-form-container" id="luxen-cod-form">
  <div class="luxen-cod-header">Completa tu pedido (Pago Contra Entrega)</div>
  
  <div class="luxen-cod-offers">
    <label class="luxen-cod-offer-card active" onclick="selectCodOffer(1, {{ product.price }})">
      <input type="radio" name="cod-quantity" value="1" checked>
      <div class="luxen-cod-offer-details">
        <div class="luxen-cod-offer-title">Lleva 1 Unidad</div>
        <div class="luxen-cod-offer-price">{{ product.price | money }}</div>
      </div>
    </label>
    
    <label class="luxen-cod-offer-card" onclick="selectCodOffer(2, {{ product.price | times: 1.6 }})">
      <span class="luxen-cod-badge">🔥 20% OFF</span>
      <input type="radio" name="cod-quantity" value="2">
      <div class="luxen-cod-offer-details">
        <div class="luxen-cod-offer-title">Lleva 2 Unidades</div>
        <div class="luxen-cod-offer-price">{{ product.price | times: 1.6 | money }}</div>
      </div>
    </label>
  </div>

  <div class="luxen-cod-field">
    <label>Nombre y Apellido *</label>
    <input type="text" id="cod-name" placeholder="Ej: Juan Pérez" required>
  </div>
  
  <div class="luxen-cod-field">
    <label>Teléfono / WhatsApp *</label>
    <input type="tel" id="cod-phone" placeholder="Ej: 0991234567" required>
  </div>
  
  <div class="luxen-cod-row">
    <div class="luxen-cod-field">
      <label>Provincia *</label>
      <select id="cod-province" required>
        <option value="" disabled selected>Selecciona...</option>
        <option value="Guayas">Guayas</option>
        <option value="Pichincha">Pichincha</option>
        <option value="Azuay">Azuay</option>
        <option value="El Oro">El Oro</option>
        <option value="Manabí">Manabí</option>
        <option value="Los Ríos">Los Ríos</option>
        <option value="Otra">Otra</option>
      </select>
    </div>
    <div class="luxen-cod-field">
      <label>Ciudad *</label>
      <input type="text" id="cod-city" placeholder="Ej: Guayaquil" required>
    </div>
  </div>

  <div class="luxen-cod-field">
    <label>Dirección Exacta y Referencia *</label>
    <input type="text" id="cod-address" placeholder="Calle principal, número y referencia" required>
  </div>

  <button type="button" class="luxen-cod-btn-submit" onclick="submitCodOrder()">
    <span class="luxen-cod-btn-title">Pedir ahora y pagar al recibir</span>
    <span class="luxen-cod-btn-sub">🚚 ¡Envío Gratis a todo Ecuador!</span>
  </button>
  
  <div class="luxen-cod-trust">
    🔒 Paga en efectivo al repartidor cuando llegue tu paquete
  </div>
</div>

<script>
  function selectCodOffer(qty, price) {
    document.querySelectorAll('.luxen-cod-offer-card').forEach(card => card.classList.remove('active'));
    event.currentTarget.classList.add('active');
  }

  function submitCodOrder() {
    const name = document.getElementById('cod-name').value.trim();
    const phone = document.getElementById('cod-phone').value.trim();
    const province = document.getElementById('cod-province').value;
    const city = document.getElementById('cod-city').value.trim();
    const address = document.getElementById('cod-address').value.trim();
    const quantity = document.querySelector('input[name="cod-quantity"]:checked').value;
    
    if(!name || !phone || !province || !city || !address) {
      alert("Por favor completa todos los campos requeridos para enviar tu pedido.");
      return;
    }
    
    // Product info
    const productTitle = "{{ product.title | escape }}";
    
    // Format message
    let msg = Hola LUXEN, quiero hacer un pedido Contra Entrega:%0A%0A;
    msg += 🛍️ *Producto:* %0A;
    msg += 📦 *Cantidad:*  Unidad(es)%0A%0A;
    msg += 👤 *Nombre:* %0A;
    msg += 📱 *Teléfono:* %0A;
    msg += 📍 *Ubicación:* , %0A;
    msg += 🏠 *Dirección:* %0A%0A;
    msg += ✅ ¡Por favor confirmen mi pedido!;
    
    const whatsappNumber = "593969280600";
    const whatsappUrl = https://wa.me/?text=;
    
    // Redirect
    window.location.href = whatsappUrl;
  }
</script>