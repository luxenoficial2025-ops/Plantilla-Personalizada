      "default": "Basado en reseñas de clientas en Ecuador"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "feature",
      "name": "Característica",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título de característica"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto descriptivo"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (Opcional, anula el SVG)"
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "Código SVG"
        }
      ]
    },
    {
      "type": "faq",
      "name": "Pregunta Frecuente",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pregunta"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Respuesta"
        }
      ]
    },
    {
      "type": "review",
      "name": "Reseña Individual",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Nombre del cliente"
        },
        {
          "type": "checkbox",
          "id": "verified",
