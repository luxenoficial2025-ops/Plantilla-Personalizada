<style>
  /* Ocultar header y footer del tema por defecto para esta landing */
  #shopify-section-header, .header-wrapper, #shopify-section-footer, .footer, .announcement-bar { display: none !important; }

  :root {
    --bg-page: #FAF8F5;
    --bg-panel: #F2ECE1;
    --bg-dark: #24201B;
    --text-dark: #2E2A24;
    --text-muted: #6B6357;
    --text-light: #FBF8F3;
    --accent: #C17A54;
    --accent-hover: #A9663F;
    --sage: #5A7550;
    --star: #FFA800;
    --line: rgba(46,42,36,0.12);
    --radius-sm: 6px;
    --radius-md: 14px;
  }
  .luxen-modular-wrapper {
    background: var(--bg-page);
    color: var(--text-dark);
    font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .luxen-modular-wrapper h1, .luxen-modular-wrapper h2, .luxen-modular-wrapper h3, .luxen-modular-wrapper h4 { font-family: 'Newsreader', Georgia, serif; font-weight: 500; margin: 0; letter-spacing: -0.01em; }
  .luxen-modular-wrapper .wrap { max-width: 1160px; margin: 0 auto; padding: 0 20px; }

  /* 1. Announcement Marquee */
  .luxen-modular-wrapper .announce {
    background: var(--bg-dark); color: #FFF; overflow: hidden;
    white-space: nowrap; font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.05em; text-transform: uppercase; padding: 9px 0;
  }
  .luxen-modular-wrapper .announce .track {
    display: inline-flex; gap: 3rem;
    animation: marquee 24s linear infinite;
  }
  @keyframes marquee { 0% { transform: translateX(0%); } 100% { transform: translateX(-50%); } }

  /* 2. Header */
  .luxen-modular-wrapper header.site {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; border-bottom: 1px solid var(--line);
    background: var(--bg-page); position: sticky; top: 0; z-index: 50;
  }
  .luxen-modular-wrapper header.site .logo { font-family: 'Newsreader', serif; font-weight: 700; font-size: 1.45rem; letter-spacing: 0.05em; }
  .luxen-modular-wrapper .badge-envio {
    font-size: 0.76rem; font-weight: 600; color: var(--text-muted);
    background: var(--bg-panel); padding: 5px 12px; border-radius: 999px;
  }

  /* 3. Grid Principal */
  .luxen-modular-wrapper .product { padding: 32px 0 0; }
  .luxen-modular-wrapper .product .grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .luxen-modular-wrapper .gallery-col { position: sticky; top: 90px; }
  .luxen-modular-wrapper .gallery-main {
    aspect-ratio: 1/1; border-radius: var(--radius-md);
    background: linear-gradient(155deg, #EADFCB 0%, #F1ECE0 100%);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; border: 1px solid var(--line);
  }
  .luxen-modular-wrapper .gallery-thumbs { display: flex; gap: 10px; margin-top: 12px; }
  .luxen-modular-wrapper .gallery-thumbs div {
    width: 68px; height: 68px; border-radius: var(--radius-sm);
    background: var(--bg-panel); border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    overflow: hidden;
  }
  .luxen-modular-wrapper .gallery-thumbs div.active { border-color: var(--accent); border-width: 2px; }

  /* Info Column */
  .luxen-modular-wrapper .info-col { padding-bottom: 40px; }
  .luxen-modular-wrapper .eyebrow { color: var(--accent); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
  .luxen-modular-wrapper .info-col h1 { font-size: clamp(1.6rem, 2.8vw, 2.1rem); line-height: 1.25; margin-bottom: 10px; }

  /* Star Rating */
  .luxen-modular-wrapper .tt-rating-row { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; margin-bottom: 12px; }
  .luxen-modular-wrapper .tt-rating-row .stars { color: var(--star); letter-spacing: 2px; }

  .luxen-modular-wrapper .price-row { display: flex; align-items: baseline; gap: 12px; margin: 12px 0; }
  .luxen-modular-wrapper .price-row .now { font-size: 1.85rem; font-weight: 700; font-family: 'Newsreader', serif; color: var(--accent); }
  .luxen-modular-wrapper .price-row .was { text-decoration: line-through; color: var(--text-muted); font-size: 1.05rem; }
  .luxen-modular-wrapper .price-row .save { background: #D85A38; color: #FFFDF8; font-size: 0.74rem; font-weight: 700; padding: 3px 9px; border-radius: 4px; }
  

  /* Social proof badge */
  
  .luxen-modular-wrapper .happy-customersV2 p {
    margin: 0 !important;
    padding: 0 !important;
  }
  .luxen-modular-wrapper .happy-customersV2 {
    display: inline-flex; align-items: center; gap: 8px;
    background: #EFE9DC; padding: 7px 14px; border-radius: 999px;
    font-size: 0.78rem; margin-bottom: 8px !important; color: var(--text-dark);
  }

  /* Fragmentos de reseñas bajo Releasit */
  .luxen-modular-wrapper .tt-bs-area {
    background: #FFF; border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 14px; margin: 18px 0 24px;
  }
  .luxen-modular-wrapper .tt-bs-title { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px; }
  .luxen-modular-wrapper .tt-bs-author { font-weight: 700; font-size: 0.85rem; }
  .luxen-modular-wrapper .tt-bs-text { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; font-style: italic; }

  /* Bloques de Descripción */
  .luxen-modular-wrapper .product__description {
    border-top: 1px solid var(--line); padding-top: 24px; margin-top: 10px;
  }
  .luxen-modular-wrapper .desc-section { text-align: center; margin-bottom: 30px; }
  .luxen-modular-wrapper .desc-section h2 { font-size: 1.35rem; margin-bottom: 8px; }
  .luxen-modular-wrapper .desc-section p { font-size: 0.94rem; color: var(--text-muted); line-height: 1.6; }
  .luxen-modular-wrapper .desc-section .art-box {
    margin: 14px auto; border-radius: var(--radius-md); background: var(--bg-panel);
    border: 1px solid var(--line); aspect-ratio: 16/9; max-width: 440px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }

  /* Acordeones */
  .luxen-modular-wrapper .accordion-wrap { border-top: 1px solid var(--line); margin-top: 24px; }
  .luxen-modular-wrapper details.acc { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .luxen-modular-wrapper details.acc summary {
    cursor: pointer; font-weight: 600; font-size: 0.96rem; list-style: none;
    display: flex; justify-content: space-between; align-items: center;
  }
  .luxen-modular-wrapper details.acc summary::-webkit-details-marker { display: none; }
  .luxen-modular-wrapper details.acc summary::after { content: "+"; font-size: 1.25rem; color: var(--accent); }
  .luxen-modular-wrapper details.acc[open] summary::after { content: "\2212"; }
  .luxen-modular-wrapper details.acc .acc-content { color: var(--text-muted); font-size: 0.9rem; margin-top: 10px; line-height: 1.6; }

  /* 4. Muro de Reseñas Trustoo */
  .luxen-modular-wrapper .reviews-section {
    padding: 64px 0; border-top: 1px solid var(--line); margin-top: 40px;
  }
  .luxen-modular-wrapper .reviews-head { text-align: center; margin-bottom: 36px; }
  .luxen-modular-wrapper .reviews-head .big-num { font-family: 'Newsreader', Georgia, serif; font-size: 3rem; font-weight: 700; line-height: 1; }
  .luxen-modular-wrapper .reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .luxen-modular-wrapper .review-card {
    background: #FFF; border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 18px;
  }
  .luxen-modular-wrapper .review-card .user { font-weight: 700; font-size: 0.86rem; margin-bottom: 4px; }
  .luxen-modular-wrapper .review-card .verified { color: #00B39B; font-weight: 600; font-size: 0.75rem; margin-left: 6px; }
  .luxen-modular-wrapper .review-card p { font-size: 0.88rem; color: var(--text-muted); margin-top: 6px; }

  /* Footer */
  .luxen-modular-wrapper footer.site {
    background: var(--bg-dark); color: rgba(251,248,243,0.6);
    padding: 40px 0 26px; font-size: 0.86rem;
  }
  .luxen-modular-wrapper footer.site .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
  .luxen-modular-wrapper footer.site a { color: inherit; text-decoration: none; margin-right: 18px; }
  .luxen-modular-wrapper footer.site .bottom { margin-top: 26px; border-top: 1px solid rgba(251,248,243,0.12); padding-top: 18px; font-size: 0.78rem; opacity: 0.7; }

  @media (max-width: 860px) {
    .luxen-modular-wrapper .product .grid { grid-template-columns: 1fr; gap: 28px; }
    .luxen-modular-wrapper .gallery-col { position: static; }
    .luxen-modular-wrapper .reviews-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="luxen-modular-wrapper">
  <!-- MARQUEE SUPERIOR -->
  {% if section.settings.marquee_text != blank %}
  <div class="announce">
    <div class="track">
      <span>{{ section.settings.marquee_text }}</span>
      <span>{{ section.settings.marquee_text }}</span>
      <span>{{ section.settings.marquee_text }}</span>
    </div>
  </div>
  {% endif %}

  <!-- HEADER -->
  <header class="site">
    <div class="logo">{{ shop.name }}</div>
    {% if section.settings.badge_envio != blank %}
    <div class="badge-envio">
      <span>{{ section.settings.badge_envio }}</span>
    </div>
    {% endif %}
  </header>

  <section class="product">
    <div class="wrap grid">

      <!-- GALERÍA MULTIMEDIA -->
      <div class="gallery-col">
        <div class="gallery-main">
          {% if product.images.size > 0 %}
            <img id="MainModularImage" src="{{ product.images.first | img_url: '800x800' }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
          {% else %}
            <div style="padding:40px; color:#6B6357;">Sin imagen</div>
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
        <div class="gallery-thumbs">
          {% for image in product.images %}
            <div class="{% if forloop.first %}active{% endif %}" onclick="luxenModularSwapImg('{{ image | img_url: '800x800' }}', this)">
              <img src="{{ image | img_url: '150x150' }}" alt="thumb" style="width:100%; height:100%; object-fit:cover;">
            </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <!-- COLUMNA DE COMPRA & CONTENIDO -->
      <div class="info-col">
        {% if section.settings.eyebrow_text != blank %}
        <div class="eyebrow">{{ section.settings.eyebrow_text }}</div>
        {% endif %}
        
        <h1>{{ product.title }}</h1>

        {% if section.settings.rating_text != blank %}
        <div class="tt-rating-row">
          <span class="stars">★★★★★</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
        {% endif %}

        <div class="price-row">
          <span class="now">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="was">{{ product.compare_at_price | money }}</span>
            {% assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
            <span class="save">-{{ saving }}%</span>
          {% endif %}
        </div>

        <!-- Social Proof -->
        {% if section.settings.social_proof_text != blank %}
        <div class="happy-customersV2">
          <span>{{ section.settings.social_proof_text }}</span>
        </div>
        {% endif %}

        {% form 'product', product, id: 'product-form-installation', class: 'form', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}">
          <input type="hidden" name="quantity" value="1">
          {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {% render block %}
              {%- endif -%}
            {%- endfor -%}
        {% endform %}

        <!-- Fragmento de Reseñas Destacadas -->
        {% if section.settings.review_highlight_text != blank %}
        <div class="tt-bs-area">
          <div class="tt-bs-title">Fragmento de reseña destacada</div>
          <div class="tt-bs-author">{{ section.settings.review_highlight_author }} <span style="color:var(--star)">★★★★★</span></div>
          <div class="tt-bs-text">"{{ section.settings.review_highlight_text }}"</div>
        </div>
        {% endif %}

        <!-- DESCRIPCIÓN PERSUASIVA -->
        <div class="product__description">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="desc-section" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <div class="art-box">
                    <img src="{{ block.settings.image | img_url: '600x' }}" style="width:100%; height:100%; object-fit:cover;" alt="{{ block.settings.title | escape }}">
                  </div>
                {% elsif block.settings.svg_code != blank %}
                  <div class="art-box">{{ block.settings.svg_code }}</div>
                {% endif %}
                <h2>{{ block.settings.title }}</h2>
                <div style="font-size: 0.94rem; color: var(--text-muted); line-height: 1.6;">{{ block.settings.text }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- ACORDEONES NATIVOS -->
        <div class="accordion-wrap">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="acc" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }}</summary>
                <div class="acc-content">{{ block.settings.content }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>

      </div>
    </div>
  </section>

  <!-- MURO DE RESEÑAS TRUSTOO -->
  <section class="reviews-section">
    <div class="wrap">
      <div class="reviews-head">
        <div class="big-num">{{ section.settings.global_rating_score | default: '5.0' }}</div>
        <div style="color:var(--star); font-size:1.2rem; margin: 6px 0;">★★★★★</div>
        <div style="color:var(--text-muted); font-size:0.86rem;">{{ section.settings.global_rating_subtitle | default: 'Basado en reseñas verificadas' }}</div>
      </div>

      <div class="reviews-grid">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="review-card" {{ block.shopify_attributes }}>
              <div style="color:var(--star); font-size:0.85rem;">
                {% for i in (1..block.settings.rating) %}★{% endfor %}
              </div>
              <div class="user">{{ block.settings.author }} {% if block.settings.verified %}<span class="verified">✓ Verificada</span>{% endif %}</div>
              <p>"{{ block.settings.text }}"</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site">
    <div class="wrap">
      <div>
        <a href="/">Inicio</a>
        <a href="/collections/all">Catálogo</a>
        <a href="/pages/contact">Contacto</a>
      </div>
      <div>
        <a href="#">Facebook</a>
        <a href="#">Instagram</a>
      </div>
    </div>
    <div class="wrap bottom">© {{ 'now' | date: '%Y' }}, {{ shop.name }} — Tienda online</div>
  </footer>

</div>

<script>
  function luxenModularSwapImg(src, el) {
    document.getElementById('MainModularImage').src = src;
    var thumbs = document.querySelectorAll('.gallery-thumbs div');
    thumbs.forEach(function(thumb) {
      thumb.classList.remove('active');
    });
    el.classList.add('active');
  }

  function triggerReleasitApp() {
    if (window.Releasit && typeof window.Releasit.openModal === 'function') {
      window.Releasit.openModal();
      return;
    }
    if (window.Releasit && typeof window.Releasit.openForm === 'function') {
      window.Releasit.openForm();
      return;
    }
    const rsiNative = document.querySelector('[data-releasit-button], .releasit-cod-button, .releasit-widget button');
    if (rsiNative) {
      rsiNative.click();
      return;
    }
    document.dispatchEvent(new CustomEvent('releasit:open'));
  }
</script>

{% schema %}
{
  "name": "Landing Modular",
  "settings": [
    {
      "type": "header",
      "content": "Textos Generales"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Texto de la marquesina superior",
      "default": "Envío GRATIS a todo Ecuador • ¡Oferta por tiempo limitado! • Paga al recibir en efectivo"
    },
    {
      "type": "text",
      "id": "badge_envio",
      "label": "Badge Envío (Cabecera)",
      "default": "🚚 Pagas en efectivo al recibir"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Texto sobre el título (Eyebrow)",
      "default": "Cuidado de la piel"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texto de calificación bajo el título",
      "default": "<strong>5.0</strong> (23 Reseñas en Ecuador)"
    },
    {
      "type": "richtext",
      "id": "social_proof_text",
      "label": "Texto Social Proof",
      "default": "<p>✔️ <strong>Daniela N.</strong> y <strong>617 personas</strong> ya lo pidieron</p>"
    },
    {
      "type": "header",
      "content": "Botón de Compra"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Texto principal del botón",
      "default": "Pedir ahora y pagar al recibir"
    },
    {
      "type": "text",
      "id": "btn_subtitle_text",
      "label": "Subtítulo del botón",
      "default": "¡Envío Gratis a todo Ecuador!"
    },
    {
      "type": "header",
      "content": "Reseña Destacada (Bajo el botón)"
    },
    {
      "type": "text",
      "id": "review_highlight_author",
      "label": "Autor de reseña destacada",
      "default": "Raquel Y."
    },
    {
      "type": "textarea",
      "id": "review_highlight_text",
      "label": "Texto de reseña destacada",
      "default": "Es el paraíso en una botella... Me encanta. Desprende las células muertas sin tallar la piel."
    },
    {
      "type": "header",
      "content": "Sección Muro de Reseñas"
    },
    {
      "type": "text",
      "id": "global_rating_score",
      "label": "Calificación global",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "global_rating_subtitle",
