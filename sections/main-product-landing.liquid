{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

<style>
  /* 1. OCULTAR HEADER Y FOOTER GLOBAL DE SHOPIFY DAWN EN ESTA PLANTILLA */
  .section-header,
  header-drawer,
  #shopify-section-header,
  .announcement-bar-section,
  #shopify-section-announcement-bar,
  footer,
  .footer,
  #shopify-section-footer,
  .footer__content-top,
  .footer__content-bottom,
  .footer__payment,
  .footer-block {
    display: none !important;
  }

  /* 2. ESTILOS BASE DE LA LANDING */
  .luxen-landing-body {
    max-width: 500px;
    margin: 0 auto;
    background: #0B0B0B;
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    padding-bottom: 90px;
    border-left: 1px solid #1a1a1a;
    border-right: 1px solid #1a1a1a;
    min-height: 100vh;
  }
  .luxen-top-bar {
    background: #000000;
    color: #D4AF37;
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    padding: 8px 12px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
    letter-spacing: 0.05em;
  }
  .luxen-hero {
    padding: 16px;
    text-align: center;
  }
  .luxen-badge {
    display: inline-block;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid #D4AF37;
    color: #D4AF37;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 10px;
  }
  .luxen-title {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 12px;
    color: #FFFFFF;
  }
  .luxen-main-img {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #262626;
    background: #141414;
    margin-bottom: 10px;
  }
  .luxen-main-img img {
    width: 100%;
    height: auto;
    display: block;
  }
  .luxen-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 14px;
  }
  .luxen-thumb-item {
    border-radius: 8px;
    border: 1px solid #333333;
    overflow: hidden;
    cursor: pointer;
    background: #181818;
    aspect-ratio: 1/1;
  }
  .luxen-thumb-item.active {
    border-color: #D4AF37;
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.4);
  }
  .luxen-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .luxen-pricing {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .luxen-pricing .compare-price {
    color: #777777;
    text-decoration: line-through;
    font-size: 16px;
  }
  .luxen-pricing .sale-price {
    color: #D4AF37;
    font-size: 26px;
    font-weight: 900;
  }
  .luxen-btn-cod {
    display: block;
    width: 100%;
    background: #FF6B00;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 16px 12px;
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(255, 107, 0, 0.4);
    transition: transform 0.15s ease;
  }
  .luxen-btn-cod:active {
    transform: scale(0.98);
  }
  .luxen-btn-subtext {
    display: block;
    font-size: 11px;
    font-weight: 600;
    opacity: 0.9;
    margin-top: 3px;
    text-transform: none;
  }
  .luxen-box {
    margin: 16px;
    padding: 16px;
    border-radius: 12px;
    background: #141414;
    border: 1px solid #222222;
  }
  .luxen-section-title {
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
    text-align: center;
    color: #FFFFFF;
  }
  .luxen-row {
    display: flex;
    gap: 10px;
    font-size: 13px;
    margin-bottom: 8px;
    color: #CCCCCC;
    align-items: flex-start;
  }
  .luxen-row.solution {
    color: #FFFFFF;
    font-weight: 600;
  }
  .luxen-media-slot {
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    background: #1C1C1C;
    border: 1px dashed #333333;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    margin-top: 10px;
    text-align: center;
    padding: 10px;
    color: #777777;
    font-size: 12px;
  }
  .luxen-media-slot img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }
  .luxen-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .luxen-card-ba {
    background: #181818;
    border-radius: 10px;
    padding: 10px;
    text-align: center;
  }
  .luxen-card-ba.bad { border-top: 3px solid #E74C3C; }
  .luxen-card-ba.good { border-top: 3px solid #27AE60; }
  .luxen-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    text-align: center;
    margin-top: 10px;
  }
  .luxen-chat {
    background: #075E54;
    border-radius: 12px;
    padding: 12px;
    margin-top: 12px;
    font-size: 12px;
  }
  .luxen-bubble {
    background: #DCF8C6;
    color: #111111;
    padding: 10px;
    border-radius: 8px;
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.4;
  }
  .luxen-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    max-width: 500px;
    margin: 0 auto;
    background: rgba(11, 11, 11, 0.95);
    backdrop-filter: blur(8px);
    padding: 10px 16px;
    border-top: 1px solid #262626;
  }

  /* 3. MICRO FOOTER MINIMALISTA */
  .luxen-landing-footer-minimal {
    text-align: center;
    padding: 24px 16px 40px;
    font-size: 11px;
    color: #777777;
    border-top: 1px solid #1f1f1f;
    margin-top: 24px;
  }
  .luxen-landing-footer-minimal p {
    margin: 4px 0;
  }
</style>

<div class="luxen-landing-body">
  <div class="luxen-top-bar">
    ⚡ PAGO AL RECIBIR • ENVÍO GRATIS A TODO ECUADOR • STOCK LIMITADO
  </div>

  <div class="luxen-hero">
    <div class="luxen-badge">★★★★★ +1,420 Clientes en Ecuador</div>
    <h1 class="luxen-title">{{ product.title }}</h1>

    <div class="luxen-main-img">
      {% if product.featured_image %}
        <img id="luxen-hero-view" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% else %}
        <div class="luxen-media-slot">Foto principal del producto</div>
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="luxen-thumbs">
        {% for img in product.images limit: 4 %}
          <div class="luxen-thumb-item {% if forloop.first %}active{% endif %}" onclick="luxenSwapImg('{{ img | image_url: width: 800 }}', this)">
            <img src="{{ img | image_url: width: 200 }}" alt="Thumb">
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="luxen-pricing">
      {% if product.compare_at_price > product.price %}
        <span class="compare-price">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <span class="sale-price">{{ product.price | money }} USD</span>
    </div>

    {% form 'product', product, id: 'product-form-landing-main', class: 'form', data-type: 'add-to-cart-form' %}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}">
  <input type="hidden" name="quantity" value="1">
  <button type="button" class="luxen-btn-cod releasit-cod-button product-form__submit">
    PEDIR AHORA Y PAGAR AL RECIBIR
    <span class="luxen-btn-subtext">🤑 ¡Pagas en efectivo al repartidor en tu puerta!</span>
  </button>
{% endform %}
  </div>

  <div class="luxen-box">
    <div class="luxen-section-title" style="color: #FF5A5F;">¿Te identificas con esto?</div>
    {% if product.metafields.custom.landing_problemas != blank %}
      {{ product.metafields.custom.landing_problemas | metafield_tag }}
    {% else %}
      <div class="luxen-row">😟 Crujidos y dolor agudo al subir escaleras o caminar.</div>
      <div class="luxen-row">😟 Rigidez constante en rodillas y articulaciones al despertar.</div>
      <div class="luxen-row">😟 Los calmantes solo duran horas y no solucionan el desgaste.</div>
    {% endif %}
    </div>
  <div class="luxen-box">
    <div class="luxen-section-title" style="color: #D4AF37;">La solución con {{ product.title }}</div>
    {% if product.metafields.custom.landing_beneficios != blank %}
      {{ product.metafields.custom.landing_beneficios | metafield_tag }}
    {% else %}
      <div class="luxen-row solution">✔️ Nutre y regenera el cartílago articular desgastado.</div>
      <div class="luxen-row solution">✔️ Aumenta la lubricación eliminando el roce hueso con hueso.</div>
      <div class="luxen-row solution">✔️ Ingredientes comprobados para un alivio duradero y seguro.</div>
    {% endif %}
  </div>

  <div class="luxen-box">
    <div class="luxen-section-title">¿Cómo actúa en tus articulaciones?</div>
    <div class="luxen-media-slot">
      {% if section.settings.infographic_image != blank %}
        <img src="{{ section.settings.infographic_image | image_url: width: 800 }}" alt="Infografía">
      {% else %}
        <span>[ Sube aquí tu Infografía / Explicación Anatómica ]</span>
      {% endif %}
    </div>
  </div>

  <div class="luxen-box">
    <div class="luxen-section-title">Resultados Clínicos Visibles</div>
    <div class="luxen-grid-2">
      <div class="luxen-card-ba bad">
        <div class="luxen-media-slot" style="min-height: 110px;">
          {% if section.settings.before_image != blank %}
            <img src="{{ section.settings.before_image | image_url: width: 400 }}" alt="Antes">
          {% else %}
            <span>[ Foto Antes / Inflamación ]</span>
          {% endif %}
        </div>
        <strong style="color: #E74C3C; font-size: 11px; display: block; margin-top: 6px;">Día 1: Dolor y Rigidez</strong>
      </div>
      <div class="luxen-card-ba good">
        <div class="luxen-media-slot" style="min-height: 110px;">
          {% if section.settings.after_image != blank %}
            <img src="{{ section.settings.after_image | image_url: width: 400 }}" alt="Después">
          {% else %}
            <span>[ Foto Después / Alivio ]</span>
          {% endif %}
        </div>
        <strong style="color: #27AE60; font-size: 11px; display: block; margin-top: 6px;">Día 21: Alivio Total</strong>
      </div>
    </div>
  </div>

  <div class="luxen-box">
    <div class="luxen-section-title">Modo de Consumo en 3 Pasos</div>
    <div class="luxen-grid-3">
      <div>
        <div class="luxen-media-slot" style="min-height: 90px;">
          {% if product.metafields.custom.landing_paso1 != blank %}
        <img src="{{ product.metafields.custom.landing_paso1 | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% elsif section.settings.step1_image != blank %}
        <img src="{{ section.settings.step1_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% else %}
        <span>💧 Paso 1</span>
      {% endif %}
        </div>
        <span style="font-size: 11px; color: #BBB; margin-top: 4px; display: block;">1 Vaso de agua</span>
      </div>
      <div>
        <div class="luxen-media-slot" style="min-height: 90px;">
          {% if product.metafields.custom.landing_paso2 != blank %}
        <img src="{{ product.metafields.custom.landing_paso2 | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% elsif section.settings.step2_image != blank %}
        <img src="{{ section.settings.step2_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% else %}
        <span>💊 Paso 2</span>
      {% endif %}
        </div>
        <span style="font-size: 11px; color: #BBB; margin-top: 4px; display: block;">Dosis diaria</span>
      </div>
      <div>
        <div class="luxen-media-slot" style="min-height: 90px;">
          {% if product.metafields.custom.landing_paso3 != blank %}
        <img src="{{ product.metafields.custom.landing_paso3 | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% elsif section.settings.step3_image != blank %}
        <img src="{{ section.settings.step3_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% else %}
        <span>🏃 Paso 3</span>
      {% endif %}
        </div>
        <span style="font-size: 11px; color: #BBB; margin-top: 4px; display: block;">Movilidad activa</span>
      </div>
    </div>
  </div>

  <div class="luxen-box">
    <div class="luxen-section-title">Clientes Reales en Ecuador</div>
    <div class="luxen-grid-2">
      <div class="luxen-media-slot" style="min-height: 120px;">
        {% if product.metafields.custom.landing_ugc1 != blank %}
        <img src="{{ product.metafields.custom.landing_ugc1 | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% elsif section.settings.ugc1_image != blank %}
        <img src="{{ section.settings.ugc1_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% else %}
        <span>📦 Entrega en Guayaquil</span>
      {% endif %}
      </div>
      <div class="luxen-media-slot" style="min-height: 120px;">
        {% if product.metafields.custom.landing_ugc2 != blank %}
        <img src="{{ product.metafields.custom.landing_ugc2 | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% elsif section.settings.ugc2_image != blank %}
        <img src="{{ section.settings.ugc2_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {% else %}
        <span>🚚 Entrega en Quito</span>
      {% endif %}
      </div>
    </div>

    <div class="luxen-chat">
      <strong>💬 Confirmación de entrega vía Servientrega:</strong>
      <div class="luxen-bubble">
        {% if product.metafields.custom.landing_chat_texto != blank %}
          "{{ product.metafields.custom.landing_chat_texto }}"
        {% else %}
          "Buenas tardes amigos de Luxen, ya recibí el frasco aquí en Machala. Pagué los $39.99 en efectivo al repartidor. Todo sellado y en orden, gracias."
        {% endif %}
        <div style="font-size: 10px; color: #666; text-align: right; margin-top: 4px;">
          {% if product.metafields.custom.landing_chat_autor != blank %}
            {{ product.metafields.custom.landing_chat_autor }}
          {% else %}
            Ayer 15:30 • Carlos M.
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  </div>

  <!-- MICRO-FOOTER ELEGANTE -->
  <div class="luxen-landing-footer-minimal">
    <p>© 2026 LUXEN. Todos los derechos reservados.</p>
    <p style="color: #444444;">Envíos seguros a nivel nacional vía Servientrega & Laar Courier.</p>
  </div>

  <div class="releasit-cod-form-container" data-product-id="{{ product.id }}"></div>
  <div class="luxen-sticky">
    {% form 'product', product, id: 'product-form-landing-sticky', class: 'form', data-type: 'add-to-cart-form' %}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}">
  <input type="hidden" name="quantity" value="1">
  <button type="button" class="luxen-btn-cod releasit-cod-button product-form__submit" style="padding: 12px;">
    PEDIR CONTRA ENTREGA - {{ product.price | money }}
    <span class="luxen-btn-subtext">Paga en efectivo al recibir tu paquete</span>
  </button>
{% endform %}
  </div>
</div>

<script>
  function luxenSwapImg(src, el) {
    const mainImg = document.getElementById('luxen-hero-view');
    if (mainImg) mainImg.src = src;
    document.querySelectorAll('.luxen-thumb-item').forEach(item => item.classList.remove('active'));
    if (el) el.classList.add('active');
  }
</script>

{% schema %}
{
  "name": "Landing COD Producto",
  "tag": "section",
  "class": "section-landing-cod",
  "settings": [
    {
      "type": "header",
      "content": "Infografía y Mecanismo"
    },
    {
      "type": "image_picker",
      "id": "infographic_image",
      "label": "Imagen de Infografía"
    },
    {
      "type": "header",
      "content": "Resultados Clínicos (Antes vs Después)"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Foto Antes (Día 1)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Foto Después (Día 21)"
    },
    {
      "type": "header",
      "content": "Modo de Consumo en 3 Pasos"
    },
    {
      "type": "image_picker",
      "id": "step1_image",
      "label": "Foto Paso 1"
    },
    {
      "type": "image_picker",
      "id": "step2_image",
      "label": "Foto Paso 2"
    },
    {
      "type": "image_picker",
      "id": "step3_image",
      "label": "Foto Paso 3"
    },
    {
      "type": "header",
      "content": "Prueba Social Real (Ecuador)"
    },
    {
      "type": "image_picker",
      "id": "ugc1_image",
      "label": "Foto Entrega 1"
    },
    {
      "type": "image_picker",
      "id": "ugc2_image",
      "label": "Foto Entrega 2"
    }
  ],
  "presets": [
    {
      "name": "Landing COD Producto"
    }
  ]
}
{% endschema %}