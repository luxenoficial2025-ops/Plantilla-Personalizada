  assign product_image_widths = '300, 400, 500, 600, 700, 800, 1000, 1200, 1400, 1600, 1800, 2000'
%}

{% capture product_image_sizes %}
  {% if full_width %}
    (min-width: 1024px) calc((100vw - {{ padding_horizontal | times: 2 }}rem - {{ cards_gap_total }}px) / {{ cards_view }}), calc((100vw - {{ padding_horizontal_mobile | times: 2 }}rem - {{ cards_gap_total_mobile }}px) / {{ cards_view_mobile }})
  {% else %}
    (min-width: {{ content_width }}px) calc(({{ content_width }}px - {{ padding_horizontal | times: 2 }}rem - {{ cards_gap_total }}px) / {{ cards_view }}), (min-width: 1024px) calc((100vw - {{ padding_horizontal | times: 2 }}rem - {{ cards_gap_total }}px) / {{ cards_view }}), calc((100vw - {{ padding_horizontal_mobile | times: 2 }}rem - {{ cards_gap_total_mobile }}px) / {{ cards_view_mobile }})
  {% endif %}
{% endcapture %}
{% assign product_image_sizes = product_image_sizes | strip | strip_newlines %}


