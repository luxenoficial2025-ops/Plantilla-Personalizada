<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  /* Snapshot the constructor this section was built against, synchronously,
     before any later section on the page can load a different Swiper version
     over the top of the shared window.Swiper global. */
  window.ssSwiperCtors = window.ssSwiperCtors || {};
  window.ssSwiperCtors['11'] = window.ssSwiperCtors['11'] || window.Swiper;
</script>

<script>
  window.ssProductIngredients5 = window.ssProductIngredients5 || {};

  function initProductIngredients5() {
    const root = document.querySelector(`.product-slider-{{ section.id }}`);
    if (!root) return;

    /* Desktop and mobile each choose grid or slider independently. Only build the
       slider when the active layout actually shows it: Swiper measures its
       container at construction, and a display:none container measures zero. */
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    const layout = isDesktop ? '{{ layout_type }}' : '{{ layout_type_mobile }}';

    if (window.ssProductIngredients5['{{ section.id }}']) {
      window.ssProductIngredients5['{{ section.id }}'].destroy(true, true);
      window.ssProductIngredients5['{{ section.id }}'] = null;
    }

    if (layout === 'slider') {
      /* Resolve the engine before touching the DOM. If it is not there yet the
         section keeps its .preview fallback, which is a tidy static layout -
         stripping the class first is what left a single full-width card. */
      const SwiperCtor = (window.ssSwiperCtors && window.ssSwiperCtors['11']) || window.Swiper;
      if (!SwiperCtor) return;

      root.classList.remove('preview');

      try {
      window.ssProductIngredients5['{{ section.id }}'] = new SwiperCtor(root, {
        speed: 300,
        navigation: {
          nextEl: `.product-btn-next-{{ section.id }}`,
          prevEl: `.product-btn-prev-{{ section.id }}`,
        },
        breakpoints: {
          320: {
            spaceBetween: parseInt(root.dataset.gapMobile || 0),
            slidesPerView: parseFloat(root.dataset.viewMobile || 1.1),
          },
          768: {
            spaceBetween: parseInt(root.dataset.gap || 0),
            slidesPerView: parseFloat(root.dataset.viewMobile || 1.1),
          },
          1024: {
            spaceBetween: parseInt(root.dataset.gap || 0),
            slidesPerView: parseFloat(root.dataset.view || 3),
          }
        },
      });
      } catch (e) {
        /* Never strand the section with Swiper's bare stylesheet applied. */
        root.classList.add('preview');
        window.ssProductIngredients5['{{ section.id }}'] = null;
      }
    }

    const items = document.querySelectorAll('.product-item-{{ section.id }}');

    items.forEach(item => {
      if (item.dataset.ssReadMoreBound) return;
      item.dataset.ssReadMoreBound = '1';

      const smallText = item.querySelector('.product-text-small-{{ section.id }}');
      const fullText = item.querySelector('.product-text-full-{{ section.id }}');
      const moreButton = item.querySelector('.product-text-more-{{ section.id }}');
      const lessButton = item.querySelector('.product-text-less-{{ section.id }}');

      if (moreButton && smallText && fullText) {
          moreButton.addEventListener('click', () => {
              smallText.classList.remove('active');
              fullText.classList.add('active');
          });
      }

      if (lessButton && smallText && fullText) {
          lessButton.addEventListener('click', () => {
              fullText.classList.remove('active');
              smallText.classList.add('active');
          });
      }
    });

  }

  document.addEventListener('DOMContentLoaded', initProductIngredients5);

  /* Second chance: if the bundle had not executed by DOMContentLoaded the slider
     was never built, so try again once everything has loaded. */
  window.addEventListener('load', function () {
    if (!window.ssProductIngredients5['{{ section.id }}']) initProductIngredients5();
  });

  /* The active layout flips between grid and slider at the desktop breakpoint,
     so rebuild when it is crossed. */
  window.matchMedia('(min-width: 1024px)').addEventListener('change', initProductIngredients5);

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initProductIngredients5);
    document.addEventListener('shopify:section:load', initProductIngredients5);
  }
</script>{%- elsif request.design_mode -%}
