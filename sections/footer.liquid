<style>
  .luxen-footer {
    background-color: #0B0B0B;
    color: #A0A0A0;
    font-family: inherit;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    padding: 60px 20px 20px 20px;
    line-height: 1.6;
  }
  .luxen-footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .luxen-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 50px;
  }
  @media (min-width: 768px) {
    .luxen-footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .luxen-footer-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
  }
  .luxen-footer-col h3, .luxen-footer-logo {
    color: #D4AF37;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .luxen-footer-logo {
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    font-weight: 900;
  }
  .luxen-footer-col p {
    margin: 0 0 10px 0;
    color: #A0A0A0;
    font-size: 0.95rem;
  }
  .luxen-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .luxen-footer-col ul li {
    margin-bottom: 12px;
  }
  .luxen-footer-col ul li a {
    color: #E5E5E5;
    text-decoration: none;
    transition: color 0.3s;
    font-size: 0.95rem;
  }
  .luxen-footer-col ul li a:hover {
    color: #D4AF37;
  }
  .luxen-footer-bullets {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .luxen-footer-bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #E5E5E5;
    font-size: 0.95rem;
  }
  .luxen-footer-bullet-icon {
    font-size: 1.2rem;
  }
  .luxen-social-row {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    align-items: center;
  }
  .luxen-social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: #141414;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 50%;
    color: #D4AF37;
    transition: all 0.3s ease;
  }
  .luxen-social-btn svg {
    width: 20px;
    height: 20px;
  }
  .luxen-social-btn:hover {
    background-color: #D4AF37;
    color: #0B0B0B;
    transform: translateY(-3px);
  }
  .luxen-footer-contact-link {
    color: #E5E5E5;
    text-decoration: none;
    transition: color 0.3s;
  }
  .luxen-footer-contact-link:hover {
    color: #D4AF37;
  }
  .luxen-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .luxen-footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .luxen-footer-copyright {
    color: #A0A0A0;
    font-size: 0.85rem;
  }
  .luxen-footer-policies {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
  }
  .luxen-footer-policies a {
    color: #A0A0A0;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s;
  }
  .luxen-footer-policies a:hover {
    color: #E5E5E5;
  }
  .luxen-footer-payment {
    display: flex;
    gap: 10px;
    color: #A0A0A0;
    font-size: 0.85rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  .luxen-footer-payment span {
    background: rgba(255,255,255,0.05);
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.1);
  }
</style>

