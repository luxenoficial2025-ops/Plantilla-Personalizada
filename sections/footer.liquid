<style>
  .luxen-footer {
    background-color: #0B0B0B;
    color: #A0A0A0;
    font-family: inherit;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
    padding: 60px 20px 20px 20px;
    line-height: 1.6;
  }
  .luxen-footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .luxen-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 50px;
  }
  @media (min-width: 768px) {
    .luxen-footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .luxen-footer-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
  }
  .luxen-footer-col h3, .luxen-footer-logo {
    color: #D4AF37;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .luxen-footer-logo {
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    font-weight: 900;
  }
  .luxen-footer-col p {
    margin: 0 0 10px 0;
    color: #A0A0A0;
    font-size: 0.95rem;
  }
  .luxen-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .luxen-footer-col ul li {
    margin-bottom: 12px;
  }
  .luxen-footer-col ul li a {
    color: #E5E5E5;
    text-decoration: none;
    transition: color 0.3s;
    font-size: 0.95rem;
  }
  .luxen-footer-col ul li a:hover {
    color: #D4AF37;
  }
  .luxen-footer-bullets {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .luxen-footer-bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #E5E5E5;
    font-size: 0.95rem;
  }
  .luxen-footer-bullet-icon {
    font-size: 1.2rem;
  }
  .luxen-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .luxen-footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .luxen-footer-copyright {
    color: #A0A0A0;
    font-size: 0.85rem;
  }
  .luxen-footer-policies {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
  }
  .luxen-footer-policies a {
    color: #A0A0A0;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s;
  }
  .luxen-footer-policies a:hover {
    color: #E5E5E5;
  }
  .luxen-footer-payment {
    display: flex;
    gap: 10px;
    color: #A0A0A0;
    font-size: 0.85rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  .luxen-footer-payment span {
    background: rgba(255,255,255,0.05);
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.1);
  }
</style>

<footer class="luxen-footer">
  <div class="luxen-footer-container">
    <div class="luxen-footer-grid">
      <!-- Columna 1 -->
      <div class="luxen-footer-col">
        <div class="luxen-footer-logo">LUXEN</div>
        <p style="color: #E5E5E5;">Productos seleccionados para tu bienestar, cuidado y estilo de vida. Compra segura con pago al recibir en todo Ecuador.</p>
      </div>

      <!-- Columna 2 -->
      <div class="luxen-footer-col">
        <h3>Atención al Cliente</h3>
        <div class="luxen-footer-bullets">
          <div class="luxen-footer-bullet">
            <span class="luxen-footer-bullet-icon">💬</span>
            <span>Atención vía WhatsApp inmediata</span>
          </div>
          <div class="luxen-footer-bullet">
            <span class="luxen-footer-bullet-icon">🕒</span>
            <span>Lunes a Sábado de 9:00 AM a 7:00 PM</span>
          </div>
          <div class="luxen-footer-bullet">
            <span class="luxen-footer-bullet-icon">📍</span>
            <span>Cobertura nacional a las 24 provincias</span>
          </div>
        </div>
      </div>

      <!-- Columna 3 -->
      <div class="luxen-footer-col">
        <h3>Información</h3>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/collections/all">Catálogo</a></li>
          <li><a href="/pages/contacto">Rastrear Pedido</a></li>
          <li><a href="/pages/faq">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <!-- Columna 4 -->
      <div class="luxen-footer-col">
        <h3>Compra 100% Segura</h3>
        <div class="luxen-footer-bullets">
          <div class="luxen-footer-bullet">
            <span class="luxen-footer-bullet-icon">📦</span>
            <span>Paga en efectivo al recibir en tu puerta</span>
          </div>
          <div class="luxen-footer-bullet">
            <span class="luxen-footer-bullet-icon">🚚</span>
            <span>Envíos por Servientrega y Laar Courier</span>
          </div>
          <div class="luxen-footer-bullet">
            <span class="luxen-footer-bullet-icon">🛡️</span>
            <span>Garantía de satisfacción de 30 días</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Línea Inferior -->
    <div class="luxen-footer-bottom">
      <div class="luxen-footer-copyright">
        © 2026 LUXEN. Todos los derechos reservados.
      </div>
      <div class="luxen-footer-policies">
        <a href="/policies/terms-of-service">Términos del servicio</a>
        <a href="/policies/privacy-policy">Política de privacidad</a>
        <a href="/policies/refund-policy">Políticas de reembolso</a>
        <a href="/policies/shipping-policy">Envíos</a>
      </div>
      <div class="luxen-footer-payment">
        <span>Pago Contra Entrega</span>
        <span>Efectivo</span>
        <span>Transferencia</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [],
  "presets": [
    {
      "name": "Luxen Footer"
    }
  ]
}
{% endschema %}