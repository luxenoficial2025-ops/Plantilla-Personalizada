{{ 'section-footer.css' | asset_url | stylesheet_tag }}
<style id="luxen-footer-fix">
  footer.footer, .footer {
    background: #0B0B0B !important;
    border-top: 1px solid #1a1a1a !important;
    padding: 35px 0 20px !important;
  }
  .footer__content-top {
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 20px 20px !important;
  }
  @media screen and (min-width: 750px) {
    .footer__blocks-wrapper {
      display: grid !important;
      grid-template-columns: 1.2fr 1fr 1fr 1fr !important;
      gap: 30px !important;
      align-items: start !important;
    }
  }
  @media screen and (max-width: 749px) {
    .footer__blocks-wrapper {
      display: flex !important;
      flex-direction: column !important;
      gap: 18px !important;
    }
  }
  .footer-block__heading {
    color: #D4AF37 !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    margin-bottom: 10px !important;
  }
  .footer-block__details-content,
  .footer-block__details-content a,
  .footer-block__details-content li,
  .footer-block__details-content p {
    color: #B3B3B3 !important;
    font-size: 12px !important;
    line-height: 1.6 !important;
  }
  .footer__list-social {
    display: flex !important;
    gap: 12px !important;
    margin-top: 10px !important;
    list-style: none !important;
    padding: 0 !important;
  }
  .footer__list-social .link {
    color: #D4AF37 !important;
  }
  .footer__content-bottom {
    border-top: 1px solid #1a1a1a !important;
    padding: 15px 20px !important;
    max-width: 1200px !important;
    margin: 0 auto !important;
    font-size: 11px !important;
    color: #666666 !important;
  }
  .luxen-footer-bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
  }
  .luxen-footer-payment {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .luxen-footer-payment span {
    background: rgba(255,255,255,0.05);
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .luxen-footer-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .luxen-footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .luxen-footer-policies a { margin: 0 8px; text-decoration: none; color: #777777; }
  .luxen-footer-policies a:hover { color: #D4AF37; }
</style>

