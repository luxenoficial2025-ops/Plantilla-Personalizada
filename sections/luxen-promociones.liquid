<style>
  .luxen-promo-wrapper {
    background-color: #0B0B0B;
    padding: 30px 15px;
    color: #ffffff;
    font-family: inherit;
  }
  .luxen-promo-header {
    text-align: center;
    font-size: 1.8rem;
    font-weight: bold;
    margin-bottom: 25px;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: 0.05em;
  }
  .luxen-promo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 768px) {
    .luxen-promo-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      padding: 0 40px;
    }
  }
  @media (min-width: 1024px) {
    .luxen-promo-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .luxen-promo-card {
    background: #111111;
    border: 1px solid #222222;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .luxen-promo-image-container {
    position: relative;
    width: 100%;
    padding-top: 100%;
    background: #1a1a1a;
  }
  .luxen-promo-image-container svg, .luxen-promo-image-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .luxen-promo-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: #D4AF37;
    color: #0B0B0B;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    z-index: 2;
  }
  .luxen-promo-info {
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }
  .luxen-promo-title {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 5px 0;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }
  .luxen-promo-reviews {
    color: #D4AF37;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .luxen-promo-reviews span {
    color: #aaaaaa;
    font-size: 0.75rem;
    margin-left: 4px;
  }
  .luxen-promo-pricing {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }
  .luxen-promo-price-current {
    font-size: 1.15rem;
    font-weight: 800;
    color: #D4AF37;
  }
  .luxen-promo-price-compare {
    font-size: 0.85rem;
    color: #888888;
    text-decoration: line-through;
  }
  .luxen-promo-btn {
    width: 100%;
    background-color: #D4AF37;
    color: #0B0B0B;
    border: none;
    padding: 10px 0;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s;
    margin-top: auto;
  }
  .luxen-promo-btn:hover {
    background-color: #bfa132;
  }
</style>

<div class="luxen-promo-wrapper">
  <h2 class="luxen-promo-header">¡PROMOCIONES! 🤩🔥</h2>
  
  <div class="luxen-promo-grid">
    {% assign promo_collection = collections[section.settings.collection] %}
    
    {% if promo_collection != blank and promo_collection.products_count > 0 %}
      {% for product in promo_collection.products limit: 10 %}
        <div class="luxen-promo-card">
          <div class="luxen-promo-image-container">
            <span class="luxen-promo-badge">Oferta</span>
            {% if product.featured_image %}
              <img src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" alt="{{ product.title | escape }}" class="luxen-promo-image" loading="lazy">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'luxen-promo-image' }}
            {% endif %}
          </div>
          <div class="luxen-promo-info">
            <h3 class="luxen-promo-title">{{ product.title }}</h3>
            <div class="luxen-promo-reviews">
              ★★★★★ <span>({{ "now" | date: "%N" | modulo: 80 | plus: 20 }})</span>
            </div>
            <div class="luxen-promo-pricing">
              <span class="luxen-promo-price-current">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="luxen-promo-price-compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
            <a href="{{ product.url }}" class="luxen-promo-btn">Comprar Ahora</a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <div class="luxen-promo-card">
          <div class="luxen-promo-image-container">
            <span class="luxen-promo-badge">Oferta</span>
            {{ 'product-' | append: i | placeholder_svg_tag: 'luxen-promo-image' }}
          </div>
          <div class="luxen-promo-info">
            <h3 class="luxen-promo-title">Producto de Alto Impacto {{ i }}</h3>
            <div class="luxen-promo-reviews">
              ★★★★★ <span>(45)</span>
            </div>
            <div class="luxen-promo-pricing">
              <span class="luxen-promo-price-current">.99</span>
              <span class="luxen-promo-price-compare">.99</span>
            </div>
            <button class="luxen-promo-btn" type="button">Comprar Ahora</button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Luxen Promociones",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de Promociones"
    }
  ],
  "presets": [
    {
      "name": "Luxen Promociones",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}