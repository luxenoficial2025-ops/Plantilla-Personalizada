{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "custom_reviews": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div style=\"display:flex; align-items:center; gap:8px; margin-top:-10px; margin-bottom:15px;\"><span style=\"color:#FACC15; font-size:1.2rem; letter-spacing:2px;\">★★★★★</span><span style=\"color:#666; font-size:0.9rem; text-decoration:underline;\">23 Reseñas</span></div>"
          }
        },
        "price": {
          "type": "price"
        },
        "custom_price_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.price__badge-sale, .badge--bottom-left { display: none !important; } .price--on-sale .price-item--regular { text-decoration: line-through; color: #999; } .price--on-sale .price-item--sale { color: #111; font-weight: 800; font-size: 1.5rem; } .custom-oferta-badge { display: inline-block; background: #C5A059; color: #fff; padding: 4px 10px; border-radius: 6px; font-weight: bold; font-size: 0.8rem; text-transform: uppercase; margin-left: 10px; vertical-align: middle; }</style><script>document.addEventListener('DOMContentLoaded', function(){ const priceContainer = document.querySelector('.price__sale'); if(priceContainer && !document.querySelector('.custom-oferta-badge')){ priceContainer.insertAdjacentHTML('beforeend', '<span class=\"custom-oferta-badge\">Oferta</span>'); } });</script>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "custom_cod": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.product-form__submit { display: none !important; } .cod-btn-custom { width: 100%; background: linear-gradient(135deg, #FF8C00, #FF6B00); color: #fff; border: none; border-radius: 8px; padding: 16px; cursor: pointer; display: flex; flex-direction: column; align-items: center; box-shadow: 0 4px 15px rgba(255,107,0,0.3); animation: codPulse 2s infinite; margin-top: -15px; margin-bottom: 20px; transition: transform 0.2s; } .cod-btn-custom:active { transform: scale(0.98); } .cod-title { font-size: 1.1rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; } .cod-sub { font-size: 0.9rem; font-weight: 500; margin-top: 4px; opacity: 0.9; } @keyframes codPulse { 0% { box-shadow: 0 0 0 0 rgba(255,107,0,0.5); } 70% { box-shadow: 0 0 0 10px rgba(255,107,0,0); } 100% { box-shadow: 0 0 0 0 rgba(255,107,0,0); } }</style><button type=\"submit\" name=\"add\" form=\"product-form-{{ section.id }}\" class=\"cod-btn-custom\"><span class=\"cod-title\">Pedir ahora y pagar al recibir</span><span class=\"cod-sub\">¡Envío Gratis!</span></button>"
          }
        },
        "custom_social_proof": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div style=\"background: #F9F9F9; border-radius: 8px; padding: 15px; margin-bottom: 20px; border: 1px solid #eee;\"><div style=\"display:flex; align-items:center; gap:10px; margin-bottom:8px;\"><div style=\"width:32px; height:32px; border-radius:50%; background:#C5A059; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:bold;\">M</div><div><div style=\"font-weight:bold; font-size:0.9rem; line-height:1;\">María Q. <span style=\"color:#22C55E;\">✓</span></div><div style=\"color:#FACC15; font-size:0.8rem;\">★★★★★</div></div></div><p style=\"font-size:0.85rem; margin:0; color:#444; font-style:italic;\">\"Excelente producto, me llegó súper rápido y pagué al recibir. ¡Recomendado!\"</p></div><div style=\"display:flex; align-items:center; gap:8px; margin-bottom:20px; padding:10px; background:#FEF2F2; border-radius:6px; color:#DC2626; font-size:0.9rem; font-weight:600;\"><span style=\"font-size:1.2rem;\">🔥</span> María Q. y 587 personas ya lo pidieron</div>"
          }
        },
        "tab_cod": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "📦 Pago contra entrega",
            "content": "<p>Pagas en efectivo al recibir en la puerta de tu casa. Sin riesgos ni tarjetas de crédito.</p>",
            "icon": "none"
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "🚚 Información de Envío",
            "content": "<p>Envío seguro a todo Ecuador de 2 a 4 días hábiles mediante transportadoras certificadas.</p>",
            "icon": "none"
          }
        },
        "tab_warranty": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "🛡️ ¿Tengo Garantía?",
            "content": "<p>Garantía de 30 días por defectos de fábrica. Tu compra está 100% protegida.</p>",
            "icon": "none"
          }
        },
        "description": {
          "type": "description"
        }
      },
      "block_order": [
        "title",
        "custom_reviews",
        "price",
        "custom_price_badge",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "custom_cod",
        "custom_social_proof",
        "tab_cod",
        "tab_shipping",
        "tab_warranty",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 20,
        "padding_bottom": 36
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "También te podría gustar",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}